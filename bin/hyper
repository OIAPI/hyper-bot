#!/usr/bin/env php
<?php
/**
 * Hyper Bot 统一入口（v2）。
 *
 * 一个命令跑三种架构：
 *
 *   php bin/hyper serve              # 按 Config.ini [runtime] arch 启动
 *   php bin/hyper serve --arch=swoole # 强制 Swoole 常驻
 *   php bin/hyper serve --arch=php    # 强制 PHP 内置服务器
 *   php bin/hyper serve --arch=webui  # 只跑 WebUI
 *
 *   php bin/hyper worker             # 独立轮询 worker（PHP 架构下执行定时/延迟任务）
 *   php bin/hyper doctor             # 环境体检：扩展、配置、目录、端口
 *   php bin/hyper passwd [用户] [密码] # 重置面板密码（--list 查看账号）
 *   php bin/hyper status             # 打印当前架构与协议状态
 *   php bin/hyper config <key> [val] # 读/写配置
 *
 * 为什么需要这个入口：v1 的启动方式只有 `php index.php`（要求 ext-swoole），
 * 而 WebUI 又是另一个 `bin/webui-serve.php`。两个入口、两套初始化、
 * 两套错误处理，且都没法在缺扩展的机器上给出友好提示。
 */
declare(strict_types=1);

// install 必须能在一个刚 clone、还没有 vendor 的目录里跑，
// 所以先看命令：需要时跳过 autoload，其余命令照旧。
$__first = strtolower((string)($argv[1] ?? ''));
if (($__first === 'install' || $__first === 'setup') && !is_file(dirname(__DIR__) . '/vendor/autoload.php')) {
    define('HYPER_SKIP_AUTOLOAD', true);
}

require dirname(__DIR__) . '/Include.php';

use Core\Bootstrap;
use Core\Config;
use Core\Runtime;
use Core\Version;

[$command, $args] = parseCli($argv ?? []);

switch ($command) {
    case 'install':
    case 'setup':
        commandInstall($args['args'], $args['options']);
        break;
    case 'serve':
        commandServe($args);
        break;
    case 'worker':
        commandWorker($args);
        break;
    case 'doctor':
        commandDoctor($args);
        break;
    case 'passwd':
    case 'password':
        commandPasswd($args);
        break;
    case 'ext':
    case 'extension':
        commandExt($args);
        break;
    case 'redis':
        commandRedis($args);
        break;
    case 'update:apply':
        commandUpdateApply($args);
        break;
    case 'status':
        commandStatus($args);
        break;
    case 'config':
        commandConfig($args);
        break;
    case 'help':
    case '':
        printHelp();
        break;
    default:
        fwrite(STDERR, "未知命令：{$command}" . PHP_EOL);
        fwrite(STDERR, "运行 php bin/hyper help 查看用法" . PHP_EOL);
        exit(1);
}

// ============================================================

/** 解析 argv：command + 位置参数 + --key=value 选项 */
function parseCli(array $argv): array
{
    array_shift($argv); // bin/hyper
    $command = '';
    $args = [];
    $options = [];
    foreach ($argv as $token) {
        if (str_starts_with($token, '--')) {
            $pair = explode('=', substr($token, 2), 2);
            $options[$pair[0]] = $pair[1] ?? true;
            continue;
        }
        if ($command === '') {
            $command = $token;
            continue;
        }
        $args[] = $token;
    }
    return [strtolower($command), ['args' => $args, 'options' => $options]];
}

function option(array $ctx, string $key, mixed $default = null): mixed
{
    return $ctx['options'][$key] ?? $default;
}

// ---------------- serve ----------------

function commandServe(array $ctx): void
{
    $arch = option($ctx, 'arch');
    if (is_string($arch) && $arch !== '') {
        putenv('HYPER_ARCH=' . $arch);
    }

    $app = Bootstrap::run(['arch' => is_string($arch) ? $arch : null]);
    $runtime = $app->runtime;

    // 协议能力与架构不匹配时，先告警再继续（不阻止启动，方便先看 WebUI）
    match ($runtime->mode) {
        Runtime::SWOOLE => serveSwoole($app, $ctx),
        Runtime::PHP => servePhp($app, $ctx),
        Runtime::WEBUI => serveWebui($app, $ctx),
        default => exit(1),
    };
}

/** Swoole 架构：交给旧的 HttpServer（它内部已经处理 Worker / WS / 定时器） */
function serveSwoole(\Core\App $app, array $ctx): void
{
    if (!extension_loaded('swoole')) {
        fwrite(STDERR, '错误：选择 swoole 架构但未安装 ext-swoole。' . PHP_EOL);
        fwrite(STDERR, '请改用 --arch=php，或安装扩展后再启动。' . PHP_EOL);
        exit(1);
    }
    echo '  入口      http://' . Config::string('http.host', '127.0.0.1')
        . ':' . Config::int('http.port', 9501) . '/webui/' . PHP_EOL . PHP_EOL;

    $server = new \Controller\Server\HttpServer();
    $server->start();
}

/** PHP 架构：内置服务器 + 轮询 worker */
function servePhp(\Core\App $app, array $ctx): void
{
    $host = option($ctx, 'host', Config::string('http.host', '127.0.0.1'));
    $port = option($ctx, 'port', Config::int('http.port', 8080));

    echo '  入口      http://' . $host . ':' . $port . '/webui/' . PHP_EOL;
    echo '  提示      PHP 架构单进程，事件串行处理；WebSocket 相关功能不可用' . PHP_EOL . PHP_EOL;

    // 同一进程内起一个轮询 worker（协程不可用，所以用「每次请求后顺带跑一次」的方案）
    serveWithBuiltinServer($app, (string)$host, (int)$port);
}

/** 仅 WebUI 架构 */
function serveWebui(\Core\App $app, array $ctx): void
{
    $host = option($ctx, 'host', Config::string('http.host', '127.0.0.1'));
    $port = option($ctx, 'port', Config::int('http.port', 8080));

    echo '  入口      http://' . $host . ':' . $port . '/webui/' . PHP_EOL;
    echo '  提示      仅 WebUI 架构：不接收协议事件，不发消息' . PHP_EOL . PHP_EOL;

    serveWithBuiltinServer($app, (string)$host, (int)$port);
}

/**
 * 用 PHP 内置服务器跑应用（v2）。
 *
 * 进程模型：
 *   ├── 主进程（本进程）：轮询 Scheduler 队列（= worker 职责），自己写 pid 文件；
 *   └── 子进程：php -S 内置服务器，提供 HTTP。
 *
 * 为什么分两个进程：内置服务器是阻塞单线程，如果 worker 和它同进程，
 * 定时任务会被请求饿死；分开后 HTTP 与调度互不拖累。
 *
 * 为什么 pid 由进程自己写：某些环境（安卓 FUSE / 受限容器）里 shell 的 \$!
 * 拿到的是外层 bash 的 PID，不是真正的服务进程，导致 stop 停不掉、status 判断错。
 */
function serveWithBuiltinServer(\Core\App $app, string $host, int $port): void
{
    $root = dirname(__DIR__);
    $router = $root . '/public/index.php';
    $docRoot = $root . '/public';
    $pidFile = $root . '/runtime/hyper-' . $port . '.pid';
    $childPidFile = $root . '/runtime/hyper-' . $port . '.child';

    // 主进程自己写 pid（不依赖 shell 的 \$!）
    @file_put_contents($pidFile, (string)getmypid());

    // 退出清理：结束子进程 + 删 pid 文件。
    //
    // 为什么既要 shutdown 函数又要信号处理：
    //   - 正常结束（循环 break / 异常）走 shutdown 函数；
    //   - `kill <pid>` 发 SIGTERM 时，PHP 默认直接终止，不走 shutdown 函数，
    //     子进程会变成孤儿并继续占着端口 —— 这正是 stop 之后端口还在响的原因。
    // 所以 SIGTERM/SIGINT 必须显式接管。
    $cleanup = static function () use ($pidFile, $childPidFile): void {
        $child = (int)@file_get_contents($childPidFile);
        if ($child > 0 && function_exists('posix_kill')) {
            @posix_kill($child, 15);
            // 给子进程一点时间优雅退出，再确认它真的没了
            for ($i = 0; $i < 20; $i++) {
                usleep(50_000);
                if (!isProcessAlive($child)) {
                    break;
                }
            }
            if (isProcessAlive($child)) {
                @posix_kill($child, 9);
            }
        }
        @unlink($pidFile);
        @unlink($childPidFile);
    };
    register_shutdown_function($cleanup);

    if (function_exists('pcntl_signal')) {
        foreach ([SIGTERM, SIGINT, SIGHUP] as $signal) {
            \pcntl_signal($signal, static function () use ($cleanup): void {
                $cleanup();
                exit(0);
            });
        }
        \pcntl_async_signals(true);
    }

    $serverCmd = escapeshellarg(PHP_BINARY)
        . ' -d opcache.enable=0 -d opcache.enable_cli=0'
        . ' -S ' . escapeshellarg($host . ':' . $port)
        . ' -t ' . escapeshellarg($docRoot)
        . ' ' . escapeshellarg($router);

    $child = spawnServerProcess($serverCmd);
    if ($child <= 0) {
        fwrite(STDERR, '启动内置服务器失败，可手动运行：' . PHP_EOL . '  ' . $serverCmd . PHP_EOL);
        @unlink($pidFile);
        exit(1);
    }
    @file_put_contents($childPidFile, (string)$child);

    // 等端口就绪（最多 6 秒），避免打印入口后立刻连不上
    $ready = false;
    for ($i = 0; $i < 12; $i++) {
        usleep(500_000);
        $probe = @fsockopen($host, $port, $errno, $errstr, 0.4);
        if (is_resource($probe)) {
            fclose($probe);
            $ready = true;
            break;
        }
        if (!isProcessAlive($child)) {
            break;
        }
    }

    if (!$ready) {
        fwrite(STDERR, '警告：内置服务器未就绪（端口可能被占用），请检查端口 ' . $port . PHP_EOL);
    } else {
        echo '  就绪      http://' . $host . ':' . $port . '/webui/' . PHP_EOL . PHP_EOL;
    }

    $logger = $app->logger;
    $logger->info('worker 已启动（PID ' . getmypid() . '，子进程 ' . $child . '，轮询间隔 1s）');

    // 主循环：执行到期任务 + 守护子进程
    while (true) {
        foreach (\Core\Scheduler::due() as $entry) {
            \Core\Scheduler::run($entry);
        }

        if (!isProcessAlive($child)) {
            $logger->warning('内置服务器进程已退出，worker 同步停止（可用 bin/hyper.sh restart 重试）');
            break;
        }
        usleep(1_000_000);
    }
}

/**
 * 启动内置服务器子进程，返回其 PID（失败返回 0）。
 *
 * 优先 pcntl_fork（不经过 shell，PID 准确、信号可达）；
 * 没有 pcntl 时退回 shell_exec 的 nohup 方案。
 */
function spawnServerProcess(string $cmd): int
{
    if (function_exists('pcntl_fork')) {
        $pid = @pcntl_fork();
        if ($pid === 0) {
            // 子进程：换成内置服务器进程映像
            @pcntl_exec('/bin/sh', ['-c', $cmd]);
            exit(0); // exec 失败
        }
        if (is_int($pid) && $pid > 0) {
            return $pid;
        }
    }

    if (function_exists('shell_exec')) {
        $output = @shell_exec('bash -c ' . escapeshellarg('nohup ' . $cmd . ' >/dev/null 2>&1 & echo $!') . ' 2>/dev/null');
        $pid = (int)trim((string)$output);
        if ($pid > 0) {
            return $pid;
        }
    }

    return 0;
}

/** 进程是否存活（不依赖 posix 扩展） */
function isProcessAlive(int $pid): bool
{
    if ($pid <= 0) {
        return false;
    }
    if (function_exists('posix_kill')) {
        return @posix_kill($pid, 0);
    }
    if (is_dir('/proc')) {
        return is_dir('/proc/' . $pid);
    }
    $out = @shell_exec('ps -p ' . $pid . ' -o pid= 2>/dev/null');
    return trim((string)$out) !== '';
}

function commandWorker(array $ctx): void
{
    $app = Bootstrap::run(['quiet' => true]);
    $logger = $app->logger;
    $logger->info('独立 worker 启动，轮询调度队列：' . \Core\Scheduler::path());

    $once = (bool)option($ctx, 'once', false);
    do {
        $count = 0;
        // 延迟队列 + cron 任务一起跑（Runner 内部会先清 Scheduler 的队列）
        foreach (\Core\Schedule\Runner::tick(true) as $item) {
            $count++;
            $logger->info('执行任务：' . ($item['name'] ?? $item['id'] ?? '?'));
        }
        $count += count(\Core\Scheduler::due());
        if ($count > 0) {
            $logger->info("本轮执行 {$count} 个到期任务");
        }
        if ($once) {
            break;
        }
        sleep(1);
    } while (true);
}

// ---------------- doctor ----------------


/**
 * Redis / KeyDB 逐步连通性诊断。
 *
 * 用户最常见的困惑是「Redis 明明能连，面板就是不用」——真正原因几乎总是
 * AUTH 密码不对、SELECT 的库不存在、或者端口上跑的根本不是 Redis，
 * 而旧代码把这些异常全吞掉后静默回退到了文件存储。
 */
function commandRedis(array $ctx): void
{
    $host = \Core\Config::string('Redis.host', '127.0.0.1');
    $port = \Core\Config::int('Redis.port', 6379);
    $auth = \Core\Config::string('Redis.auth', '');
    $select = \Core\Config::int('Redis.select', 0);
    $masked = $auth === '' ? '（未配置）' : str_repeat('*', max(0, strlen($auth) - 2)) . substr($auth, -2);

    $line = static function (string $step, bool $ok, string $detail = ''): void {
        printf("  %-12s %s%s\n", $step, $ok ? 'OK  ' : 'FAIL', $detail !== '' ? '  ' . $detail : '');
    };

    echo PHP_EOL;
    echo '  目标    ' . $host . ':' . $port . '  db=' . $select . '  auth=' . $masked . PHP_EOL;
    echo '  配置    ' . \Core\Config::path() . PHP_EOL;
    echo '  ' . str_repeat('-', 66) . PHP_EOL;

    if (!class_exists('Redis')) {
        $line('ext-redis', false, '没有 php-redis 扩展，只能使用文件存储');
        echo PHP_EOL . '  安装示例：apt install php-redis（或 pecl install redis）' . PHP_EOL . PHP_EOL;
        return;
    }
    $line('ext-redis', true, phpversion('redis') ?: '');

    $client = new \Redis();
    $error = '';
    try {
        $connected = @$client->connect($host, $port, 1.5);
    } catch (\Throwable $e) {
        $connected = false;
        $error = $e->getMessage();
    }
    $line('TCP 连接', $connected === true, $connected === true ? '' : ($error !== '' ? $error : '连不上（端口未开 / 防火墙 / 只监听 127.0.0.1 / 容器端口没映射）'));
    if ($connected !== true) {
        echo PHP_EOL . '  提示：容器部署时 Redis 若在容器内，面板应连 127.0.0.1:映射端口；' . PHP_EOL
            . '        若面板也在容器里，host 要写容器名（如 redis）而不是 127.0.0.1。' . PHP_EOL . PHP_EOL;
        return;
    }

    if ($auth !== '') {
        try {
            @$client->auth($auth);
            $line('AUTH', true);
        } catch (\Throwable $e) {
            $msg = $e->getMessage();
            if (stripos($msg, 'no password is set') !== false) {
                $line('AUTH', true, '服务器没设密码，跳过（配置里的 auth 可删掉）');
            } else {
                $line('AUTH', false, $msg . '  ← 密码与服务器 requirepass 不一致');
                echo PHP_EOL . '  提示：KeyDB/Redis 的启动参数是 --requirepass <密码>；' . PHP_EOL
                    . '        写成 --require pass <密码>（中间有空格）不会生效，服务端等于没密码。' . PHP_EOL . PHP_EOL;
                return;
            }
        }
    } else {
        $line('AUTH', true, '未配置密码');
    }

    if ($select > 0) {
        try {
            @$client->select($select);
            $line('SELECT ' . $select, true);
        } catch (\Throwable $e) {
            $line('SELECT ' . $select, false, $e->getMessage() . '  ← 库索引超出范围（默认只有 0-15）或该库被禁');
            return;
        }
    } else {
        $line('SELECT', true, '使用 db=0');
    }

    try {
        $pong = @$client->ping();
        $line('PING', $pong !== false && $pong !== null, is_string($pong) ? $pong : '');
        if ($pong === false || $pong === null) {
            echo PHP_EOL . '  提示：端口能连但不是 Redis 协议，检查是不是被 nginx / 其他 HTTP 服务占用。' . PHP_EOL . PHP_EOL;
            return;
        }
    } catch (\Throwable $e) {
        $line('PING', false, $e->getMessage());
        return;
    }

    $key = 'hyper:doctor:' . bin2hex(random_bytes(4));
    try {
        $set = (bool)@$client->set($key, 'ok');
        $get = (string)@$client->get($key);
        @$client->del($key);
        $line('读写往返', $set && $get === 'ok', $set && $get === 'ok' ? 'set/get/del 正常' : '写入或读取失败');
    } catch (\Throwable $e) {
        $line('读写往返', false, $e->getMessage());
    }

    try {
        $info = (array)@$client->info('server');
        $version = (string)($info['redis_version'] ?? $info['keydb_version'] ?? '');
        $line('服务端', true, ($info['keydb_version'] ?? '') !== '' ? 'KeyDB ' . $version : 'Redis ' . $version);
    } catch (\Throwable) {
        // 某些托管实例禁用 INFO，不算失败
    }

    try {
        $line('会话存储', true, '面板会话默认存本地文件（webui.session_store=file），不受 Redis 抖动影响');
    } catch (\Throwable) {
    }

    // 最后一步：让内核真的建一次 store，看看面板实际用的是哪个
    echo PHP_EOL;
    try {
        $app = \Core\App::boot();
        $store = $app->store;
        $class = get_class($store);
        $driver = strtolower(\Core\Config::string('store.driver', 'auto'));
        if ($store instanceof \Core\Store\ResilientStore) {
            $degraded = $store->degraded();
            $line('面板存储', !$degraded, 'Redis（' . get_class($store->primary()) . '）' . ($degraded ? '，当前已降级到文件存储' : '') . '  store.driver=' . $driver);
        } elseif ($store instanceof \Core\Store\FileStore) {
            $line('面板存储', true, '文件存储（runtime/store）  store.driver=' . $driver);
        } else {
            $line('面板存储', true, $class . '  store.driver=' . $driver);
        }
        if ($store instanceof \Core\Store\FileStore && $driver === 'auto') {
            echo '  说明：driver=auto 且回退到文件存储，说明启动时的连接检查没通过（上面应有 WARNING）。' . PHP_EOL;
        }
        if ($driver === 'file') {
            echo '  说明：Config.ini 里 [store] driver = file 强制使用文件存储，删掉或改成 auto 才会用 Redis。' . PHP_EOL;
        }
    } catch (\Throwable $e) {
        $line('面板存储', false, '内核初始化失败：' . $e->getMessage());
    }

    echo PHP_EOL . '  结论：Redis 可用。' . PHP_EOL . PHP_EOL;
}

/** 环境体检：把所有「能不能跑」的判断集中到一处 */
/**
 * 重置面板密码。
 *
 * 典型场景：换了发布包 / 清了 runtime 目录后 users.json 被重新初始化成随机密码，
 * 面板上怎么登都提示密码错误。这条命令直接改 bcrypt 记录，不用手动删文件。
 */
function commandExt(array $args): void
{
    $app = \Core\App::boot();
    $registry = $app->registry;
    // 先 boot 一次，插件才会把钩子注册进来（HTTP 请求里由 Kernel 负责）
    \Core\Extension\ExtensionPoint::boot($registry);
    $commands = \Core\Extension\ExtensionPoint::commands($registry);

    $name = (string)($args['args'][0] ?? '');
    if ($name === '' || $name === 'list') {
        $diag = \Core\Extension\ExtensionPoint::diag($registry);
        echo PHP_EOL . '  插件扩展（开启 ' . $diag['plugins'] . ' 个）' . PHP_EOL;
        echo '  ' . str_repeat('-', 64) . PHP_EOL;
        echo '  菜单 ' . $diag['menus'] . ' 个 · 注入块 ' . $diag['widgets'] . ' 个 · 中间件 ' . $diag['middlewares'] . ' 个' . PHP_EOL;
        if ($diag['hooks'] === []) {
            echo '  钩子：没有插件注册' . PHP_EOL;
        } else {
            echo '  钩子：' . PHP_EOL;
            foreach ($diag['hooks'] as $hook) {
                echo '    ' . str_pad($hook['name'], 26) . ' ' . $hook['handlers'] . ' 个处理器  ' . implode(', ', $hook['owners']) . PHP_EOL;
            }
        }
        if ($commands === []) {
            echo '  命令：没有插件提供' . PHP_EOL;
        } else {
            echo '  命令：' . PHP_EOL;
            foreach ($commands as $cmd => $meta) {
                echo '    ' . str_pad($cmd, 26) . ' ' . $meta['desc'] . '  [' . $meta['plugin'] . ']' . PHP_EOL;
            }
        }
        echo PHP_EOL . '  执行：php bin/hyper ext <命令名> [json参数]' . PHP_EOL . PHP_EOL;
        return;
    }

    if (!isset($commands[$name])) {
        fwrite(STDERR, "没有这个扩展命令：{$name}" . PHP_EOL);
        fwrite(STDERR, '可用：' . implode(', ', array_keys($commands)) . PHP_EOL);
        exit(1);
    }
    $input = [];
    $raw = (string)($args['args'][1] ?? '');
    if ($raw !== '') {
        $decoded = json_decode($raw, true);
        if (!is_array($decoded)) {
            fwrite(STDERR, '参数必须是 JSON 对象，例如 {"limit":5}' . PHP_EOL);
            exit(1);
        }
        $input = $decoded;
    }
    try {
        $result = ($commands[$name]['handler'])($input);
        echo is_string($result) ? $result . PHP_EOL : (string)json_encode($result, JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT) . PHP_EOL;
    } catch (\Throwable $e) {
        fwrite(STDERR, '执行失败：' . $e->getMessage() . PHP_EOL);
        exit(1);
    }
}

function commandPasswd(array $ctx): void
{
    $list = $ctx['args'];
    $options = $ctx['options'];

    // --path / --verify：排查「明明重置了却登不上」用
    if (isset($options['path']) || in_array('--path', $list, true)) {
        $file = \Webui\Auth::usersFile();
        $exists = is_file($file);
        echo PHP_EOL;
        echo '  账号库  ' . $file . PHP_EOL;
        echo '  状态    ' . ($exists ? ($isReadable = is_readable($file) ? '存在且可读' : '存在但不可读（属主/权限问题）') : '不存在（首次请求会自动创建 admin）') . PHP_EOL;
        if ($exists) {
            echo '  大小    ' . (int)@filesize($file) . ' 字节，' . count(\Webui\Auth::users()) . ' 个账号' . PHP_EOL;
            echo '  属主    ' . (function_exists('posix_getpwuid') ? (@posix_getpwuid(@fileowner($file))['name'] ?? '?') : '?') . PHP_EOL;
            $writable = \Webui\Auth::fileWritable();
            echo '  可写    ' . ($writable ? '是' : '否（重启会重建账号 → 表现为「每次重启密码都变」）') . PHP_EOL;
            echo '  运行用户 ' . (function_exists('posix_geteuid') ? (@posix_getpwuid(posix_geteuid())['name'] ?? '?') : '?') . PHP_EOL;
        }
        $err = \Webui\Auth::storageError();
        if ($err !== null) {
            echo '  故障    ' . $err . PHP_EOL;
        }
        echo PHP_EOL;
        return;
    }

    if (isset($options['verify']) || in_array('--verify', $list, true)) {
        $u = (string)($list[1] ?? 'admin');
        $pw = (string)($list[2] ?? '');
        $ok = \Webui\Auth::verify($u, $pw) !== null;
        echo PHP_EOL . '  校验 ' . $u . '：' . ($ok ? '密码正确' : '密码不匹配') . PHP_EOL;
        echo '  账号库 ' . \Webui\Auth::usersFile() . PHP_EOL . PHP_EOL;
        exit($ok ? 0 : 1);
    }

    if (isset($options['list']) || in_array('--list', $list, true) || in_array('list', $list, true)) {
        $users = \Webui\Auth::users();
        if ($users === []) {
            echo '  还没有任何账号：用 php bin/hyper passwd admin <密码> 创建' . PHP_EOL;
            return;
        }
        echo PHP_EOL . '  ' . str_pad('用户名', 20) . str_pad('角色', 10) . '已绑定' . PHP_EOL;
        echo '  ' . str_repeat('─', 46) . PHP_EOL;
        foreach ($users as $name => $row) {
            $bound = is_array($row['bindings'] ?? null) ? implode(',', array_keys($row['bindings'])) : '';
            echo '  ' . str_pad((string)$name, 20) . str_pad((string)($row['role'] ?? 'viewer'), 10) . ($bound !== '' ? $bound : '—') . PHP_EOL;
        }
        echo PHP_EOL . '  重置密码：php bin/hyper passwd <用户名> <新密码>' . PHP_EOL . PHP_EOL;
        return;
    }

    $username = (string)($list[0] ?? 'admin');
    $password = (string)($list[1] ?? '');
    $generated = false;
    if ($password === '') {
        $password = \Webui\Auth::randomPassword();
        $generated = true;
    }
    $error = \Webui\Auth::setPassword($username, $password, (string)($options['role'] ?? ''));
    if ($error !== null) {
        fwrite(STDERR, '  ✗ ' . $error . PHP_EOL);
        exit(1);
    }
    $record = \Webui\Auth::users()[$username] ?? [];
    echo PHP_EOL;
    echo '  ✓ 密码已更新' . PHP_EOL;
    echo '    用户名  ' . $username . PHP_EOL;
    echo '    密码    ' . $password . ($generated ? '（自动生成，请立即抄走）' : '') . PHP_EOL;
    echo '    角色    ' . (string)($record['role'] ?? 'admin') . PHP_EOL;
    echo '    账号库  ' . \Webui\Auth::usersFile() . PHP_EOL;
    echo PHP_EOL . '  登录后请到「账号设置」改掉它。' . PHP_EOL . PHP_EOL;
}

function commandDoctor(array $ctx): void
{
    $root = dirname(__DIR__);
    $rows = [];

    // optional=true 的项缺失只提示（WARN），不算失败
    $check = static function (string $name, bool $ok, string $detail = '', bool $optional = false) use (&$rows): void {
        $rows[] = [$name, $ok ? 'OK' : ($optional ? 'WARN' : 'FAIL'), $detail];
    };

    // 扩展
    $check('PHP 版本 >= 8.1', PHP_VERSION_ID >= 80100, PHP_VERSION);
    $check('ext-json', extension_loaded('json'), '必需');
    $check('ext-mbstring', extension_loaded('mbstring'), '中文处理必需');
    $check('ext-curl', extension_loaded('curl'), '协议调用必需');
    $check('ext-openssl', extension_loaded('openssl'), 'HTTPS 必需');
    $check('ext-swoole', extension_loaded('swoole'), '可选：装了就默认跑 swoole，否则降级 php', true);
    $check('ext-sodium', extension_loaded('sodium'), '可选：QQ 官方 Webhook 验签需要', true);
    $check('ext-redis', extension_loaded('redis'), '可选：缺失时用文件存储', true);

    // 连得上不等于对端是 Redis：端口被 HTTP 服务占用时会报 protocol error，
    // 面板表现为「每个请求都 500」，所以这里真的 PING 一次
    $driver = strtolower(\Core\Config::string('store.driver', 'auto'));
    if (extension_loaded('redis') && in_array($driver, ['auto', 'redis'], true)) {
        $host = \Core\Config::string('Redis.host', '127.0.0.1');
        $port = \Core\Config::int('Redis.port', 6379);
        $pingOk = false;
        $detail = '连不上 ' . $host . ':' . $port;
        try {
            $probe = new \Redis();
            if (@$probe->connect($host, $port, 0.8) === true) {
                try {
                    $pong = @$probe->ping();
                    $pingOk = $pong !== false;
                    $detail = $pingOk ? 'PING ' . $host . ':' . $port . ' 正常' : 'PING 无响应：' . $host . ':' . $port;
                } catch (\Throwable $e) {
                    $detail = '连上了但不是 Redis（' . $host . ':' . $port . '）：' . $e->getMessage();
                }
                @$probe->close();
            }
        } catch (\Throwable $e) {
            $detail = 'Redis 探测失败：' . $e->getMessage();
        }
        $check('Redis 可用（可选）', $pingOk, $detail, true);
    }

    // 目录
    foreach (['runtime', 'runtime/log', 'runtime/store', 'runtime/webui'] as $dir) {
        $path = $root . '/' . $dir;
        if (!is_dir($path)) {
            @mkdir($path, 0775, true);
        }
        $check("目录可写：{$dir}", is_dir($path) && is_writable($path), $path);
    }

    // 配置
    $path = Config::path();
    // 账号库排在 Config 之前：这一项坏了会表现成「每次重启密码都变」
    $users = \Webui\Auth::usersFile();
    if (is_file($users)) {
        $check('账号库可读', is_readable($users), $users);
        $check('账号库可写（否则重启会重建账号）', is_writable($users), $users);
    } else {
        $check('账号库可写（首次启动要创建 admin）', is_writable(dirname($users)), dirname($users));
    }
    $check('Config.ini 可读', is_readable($path), $path);
    $check('Config.ini 可写（WebUI 改配置需要）', is_writable($path), $path);

    // composer autoload
    $wsEnabled = \Core\Config::bool('protocol.onebot.reverse.enable', false)
        || (\Core\Config::bool('protocol.milky.enable', false) && \Core\Config::string('protocol.milky.ws.server_path', '') !== '');
    $check('WS 服务端', true, $wsEnabled
        ? '启用：监听 ' . \Core\Config::string('protocol.onebot.reverse.path', '/onebot/v11/ws')
        : '未启用：不监听 WS 端口（默认行为，需要反向 WS 时才打开）');

    $autoloadOk = is_file($root . '/vendor/autoload.php');
    $check('vendor/autoload.php', $autoloadOk, $autoloadOk ? '依赖已就绪' : '运行 php bin/hyper install');

    echo PHP_EOL . '  Hyper Bot ' . Version::current() . ' 环境体检' . PHP_EOL;
    echo '  ' . str_repeat('─', 62) . PHP_EOL;
    foreach ($rows as [$name, $status, $detail]) {
        printf("  %-6s %-34s %s\n", $status, $name, $detail);
    }
    echo '  ' . str_repeat('─', 62) . PHP_EOL;

    // 架构结论
    $runtime = Runtime::fromConfig();
    echo '  推荐架构  ' . $runtime->describe() . PHP_EOL;
    if ($runtime->degraded) {
        echo '  ⚠ ' . $runtime->reason . PHP_EOL;
    }
    echo PHP_EOL;

    $fails = [];
    $warns = 0;
    foreach ($rows as [$name, $status]) {
        if ($status === 'FAIL') {
            $fails[] = $name;
        } elseif ($status === 'WARN') {
            $warns++;
        }
    }
    if ($fails === []) {
        echo '  ✓ 必需项全部通过' . ($warns > 0 ? "（{$warns} 项可选扩展未安装）" : '') . PHP_EOL . PHP_EOL;
    } else {
        echo '  ✗ 失败 ' . count($fails) . ' 项：' . implode('、', $fails) . PHP_EOL . PHP_EOL;
    }
    exit($fails === [] ? 0 : 1);
}

// ---------------- status ----------------

function commandStatus(array $ctx): void
{
    $app = Bootstrap::run(['quiet' => true]);
    $runtime = $app->runtime;

    echo PHP_EOL . '  Hyper Bot ' . Version::current() . ' 状态' . PHP_EOL;
    echo '  ' . str_repeat('─', 52) . PHP_EOL;
    echo '  架构      ' . $runtime->describe() . PHP_EOL;
    echo '  存储      ' . get_class($app->store) . PHP_EOL;
    echo '  配置      ' . Config::path() . PHP_EOL;
    echo '  订阅      ' . json_encode($app->subscription->toArray(), JSON_UNESCAPED_UNICODE) . PHP_EOL;
    echo '  插件      ' . count($app->registry->plugins()) . ' 个' . PHP_EOL;

    echo '  协议      ';
    $protocols = [];
    foreach (['onebot', 'milky', 'qqbot'] as $name) {
        if (Config::bool("protocol.{$name}.enable", false)) {
            $protocols[] = $name;
        }
    }
    echo $protocols === [] ? '（未启用扩展协议，仅 HTTP）' : implode(', ', $protocols);
    echo PHP_EOL . PHP_EOL;
}

// ---------------- config ----------------

function commandConfig(array $ctx): void
{
    $key = $ctx['args'][0] ?? null;
    if ($key === null) {
        echo json_encode(Config::all(true), JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT) . PHP_EOL;
        return;
    }

    if (count($ctx['args']) === 1) {
        $value = Config::get($key, null);
        echo is_scalar($value) || $value === null
            ? var_export($value, true) . PHP_EOL
            : json_encode($value, JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT) . PHP_EOL;
        return;
    }

    $raw = implode(' ', array_slice($ctx['args'], 1));
    $value = match (strtolower($raw)) {
        'true', 'on', 'yes' => true,
        'false', 'off', 'no' => false,
        'null' => null,
        default => is_numeric($raw) ? (str_contains($raw, '.') ? (float)$raw : (int)$raw) : $raw,
    };
    if (!Config::set($key, $value)) {
        fwrite(STDERR, "写入失败：Config.ini 不可写或键不合法" . PHP_EOL);
        exit(1);
    }
    echo "已写入 {$key} = " . var_export(Config::get($key, null), true) . PHP_EOL;
}

// ---------------- install ----------------

/**
 * 一键准备运行环境：扩展检查 + 依赖安装 + 运行时目录。
 *
 * 刻意不碰 Config / Runtime 等类：vendor 还没装时 autoload 不可用，
 * 这个命令必须能在「刚 clone、什么都没装」的状态下跑完。
 */
function commandInstall(array $args, array $options): void
{
    $root = dirname(__DIR__);
    $withDev = isset($options['dev']);
    $force = isset($options['force']);
    $ok = true;

    // 中文按显示宽度补空格，否则 %-32s 会按字节数错位
    $say = static function (string $status, string $name, string $detail = ''): void {
        $pad = max(0, 32 - mb_strwidth($name, 'UTF-8'));
        printf("  %-6s %s%s %s\n", $status, $name, str_repeat(' ', $pad), $detail);
    };

    echo PHP_EOL . '  Hyper Bot 安装 / 环境准备' . PHP_EOL;
    echo '  ' . str_repeat('─', 64) . PHP_EOL;

    // 1) PHP 与扩展
    $versionOk = PHP_VERSION_ID >= 80100;
    $say($versionOk ? 'OK' : 'FAIL', 'PHP >= 8.1', PHP_VERSION);
    $ok = $ok && $versionOk;

    $extensions = [
        ['json', true, '必需'],
        ['mbstring', true, '必需（中文处理）'],
        ['curl', true, '必需（协议调用）'],
        ['openssl', true, '必需（HTTPS）'],
        ['swoole', false, '可选（swoole 架构）'],
        ['sodium', false, '可选（QQ 官方验签）'],
        ['redis', false, '可选（缺失走文件存储）'],
    ];
    foreach ($extensions as [$ext, $required, $detail]) {
        $loaded = extension_loaded($ext);
        if (!$loaded && $required) {
            $ok = false;
        }
        $say($loaded ? 'OK' : ($required ? 'FAIL' : 'SKIP'), 'ext-' . $ext, $detail);
    }

    // 2) 运行时目录与配置可写
    $created = 0;
    foreach (['runtime', 'runtime/log', 'runtime/store', 'runtime/webui', 'runtime/github'] as $dir) {
        $path = $root . '/' . $dir;
        if (!is_dir($path)) {
            if (@mkdir($path, 0775, true)) {
                $created++;
            }
        }
        $writable = is_dir($path) && is_writable($path);
        if (!$writable) {
            $ok = false;
        }
        $say($writable ? 'OK' : 'FAIL', '目录可写：' . $dir, $path);
    }
    $configPath = $root . '/Config.ini';
    $configOk = is_file($configPath) && is_writable($configPath);
    if (!$configOk) {
        $ok = false;
    }
    $say($configOk ? 'OK' : 'FAIL', 'Config.ini 可写', $configPath);

    // 3) Composer 依赖
    $autoload = $root . '/vendor/autoload.php';
    $deps = 'skip';
    if (is_file($autoload) && !$force) {
        $say('OK', 'vendor/autoload.php', '已就绪，跳过依赖安装（--force 重装）');
    } else {
        $composer = findComposer();
        if ($composer === null && isset($options['download-composer'])) {
            $say('WAIT', 'composer', '未找到，尝试下载 composer.phar …');
            $composer = downloadComposer($root, $say);
        }
        if ($composer === null) {
            $say('FAIL', 'composer', '未找到：装好 composer 后重跑 php bin/hyper install');
            echo PHP_EOL . '  提示 没有 composer？加 --download-composer 让脚本自己下载' . PHP_EOL;
            $ok = false;
        } else {
            $cmd = composerCommand($composer) . ' install'
                . ($withDev ? '' : ' --no-dev')
                . ' --optimize-autoloader --no-interaction --no-progress';
            $say('WAIT', 'composer install', ($withDev ? '含 dev' : '--no-dev') . '，下载依赖中 …');
            $code = runInDir($root, $cmd, true);
            if ($code === 0 && is_file($autoload)) {
                $say('OK', 'composer install', '依赖已就绪');
                $deps = 'installed';
            } else {
                $say('FAIL', 'composer install', '退出码 ' . $code);
                $ok = false;
            }
        }
    }

    echo '  ' . str_repeat('─', 64) . PHP_EOL;
    if ($ok) {
        // 明确说清楚这次到底做了什么，避免「跑完好像什么都没变」的误解
        $changes = [];
        $changes[] = $deps === 'installed' ? '已安装依赖' : '依赖已就绪（未重复下载）';
        $changes[] = $created > 0 ? "新建 {$created} 个运行时目录" : '运行时目录已就绪';
        echo '  环境就绪：' . implode('，', $changes) . PHP_EOL;
        echo '  下一步：php bin/hyper doctor，然后 php bin/hyper serve（默认 swoole）' . PHP_EOL . PHP_EOL;
        exit(0);
    }
    echo '  有未通过的项，按上面提示处理后重跑。' . PHP_EOL . PHP_EOL;
    exit(1);
}

/** 后台应用更新包（由 UpdateService::startJob 拉起，不要在终端手动跑长任务） */
function commandUpdateApply(array $ctx): void
{
    $file = (string)($ctx['args'][0] ?? '');
    if ($file === '' || !is_file($file)) {
        fwrite(STDERR, "找不到要应用的压缩包：{$file}" . PHP_EOL);
        exit(1);
    }
    $code = \Core\Update\UpdateService::runJob(
        $file,
        (string)option($ctx, 'id', ''),
        (string)option($ctx, 'source', 'zip')
    );
    exit($code);
}

/** 找 composer：$COMPOSER_BINARY > 项目内 composer.phar > PATH */
function findComposer(): ?string
{
    $env = getenv('COMPOSER_BINARY');
    if (is_string($env) && $env !== '' && is_file($env)) {
        return $env;
    }
    $root = dirname(__DIR__);
    foreach ([$root . '/composer.phar', dirname($root) . '/composer.phar'] as $candidate) {
        if (is_file($candidate)) {
            return $candidate;
        }
    }
    $found = trim((string)@shell_exec('command -v composer 2>/dev/null'));
    return ($found !== '' && is_file($found)) ? $found : null;
}

/** composer.phar 要用 php 跑；PATH 里的 shim（#! 开头）直接跑 */
function composerCommand(string $composer): string
{
    $head = (string)@file_get_contents($composer, false, null, 0, 2);
    if ($head === '#!') {
        return escapeshellarg($composer);
    }
    return escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg($composer);
}

/** 在指定目录执行命令；$passthru=true 时 composer 的进度直接打到终端 */
function runInDir(string $cwd, string $cmd, bool $passthru = false): int
{
    $code = 0;
    if ($passthru && function_exists('passthru')) {
        @passthru('cd ' . escapeshellarg($cwd) . ' && ' . $cmd, $code);
        return (int)$code;
    }
    @exec('cd ' . escapeshellarg($cwd) . ' && ' . $cmd . ' 2>&1', $out, $code);
    foreach ($out as $line) {
        echo '    ' . $line . PHP_EOL;
    }
    return (int)$code;
}

/** 下载官方 composer.phar（仅在 --download-composer 时触发） */
function downloadComposer(string $root, callable $say): ?string
{
    $url = 'https://getcomposer.org/installer';
    $installer = $root . '/composer-setup.php';
    $target = $root . '/composer.phar';
    $bytes = false;

    if (function_exists('curl_init')) {
        $ch = curl_init($url);
        curl_setopt_array($ch, [
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_FOLLOWLOCATION => true,
            CURLOPT_CONNECTTIMEOUT => 10,
            CURLOPT_TIMEOUT => 30,
        ]);
        $bytes = curl_exec($ch);
        curl_close($ch);
    }
    if (!is_string($bytes) && ini_get('allow_url_fopen')) {
        $bytes = @file_get_contents($url);
    }
    if (!is_string($bytes) || !str_contains($bytes, 'Composer')) {
        $say('FAIL', '下载 composer', '网络不可达：' . $url);
        return null;
    }

    @file_put_contents($installer, $bytes);
    $code = runInDir($root, escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg($installer)
        . ' --quiet --install-dir=' . escapeshellarg($root) . ' --filename=composer.phar');
    @unlink($installer);

    if ($code === 0 && is_file($target)) {
        $say('OK', '下载 composer', $target);
        return $target;
    }
    $say('FAIL', '下载 composer', '安装器执行失败（退出码 ' . $code . '）');
    return null;
}

// ---------------- help ----------------

function printHelp(): void
{
    echo PHP_EOL . '  Hyper Bot ' . Version::current() . ' — OneBot11 / Milky / QQ 官方机器人' . PHP_EOL;
    echo '  ' . str_repeat('─', 62) . PHP_EOL . PHP_EOL;
    echo '  php bin/hyper serve [--arch=swoole|php|webui] [--port=8080] [--host=127.0.0.1]' . PHP_EOL;
    echo '      启动服务。不传 --arch 则读 Config.ini [runtime] arch（默认 swoole）' . PHP_EOL;
    echo PHP_EOL;
    echo '  php bin/hyper worker [--once]' . PHP_EOL;
    echo '      只跑调度队列（定时/延迟任务），与 serve 分离部署时用' . PHP_EOL;
    echo PHP_EOL;
    echo '  php bin/hyper install [--force] [--dev] [--download-composer]' . PHP_EOL;
    echo '      一键准备环境：扩展检查 / composer install --no-dev -o / 运行时目录' . PHP_EOL;
    echo PHP_EOL;
    echo '  php bin/hyper doctor' . PHP_EOL;
    echo '      环境体检：扩展 / 目录 / 配置 / 推荐架构' . PHP_EOL;
    echo PHP_EOL;
    echo '  php bin/hyper passwd [用户名] [新密码] [--list] [--role=owner|admin|viewer]' . PHP_EOL;
    echo '      重置面板密码（忘记密码时用）；不给密码则生成随机强密码' . PHP_EOL;
    echo PHP_EOL;
    echo '  php bin/hyper redis' . PHP_EOL;
    echo '      逐步诊断 Redis/KeyDB：扩展 / TCP / AUTH / SELECT / PING / 读写' . PHP_EOL;
    echo PHP_EOL;
    echo '  php bin/hyper status' . PHP_EOL;
    echo '      打印当前架构、存储、订阅、协议启用情况' . PHP_EOL;
    echo PHP_EOL;
    echo '  php bin/hyper config [key] [value]' . PHP_EOL;
    echo '      读/写配置项。例：php bin/hyper config runtime.arch php' . PHP_EOL;
    echo PHP_EOL . '  ' . str_repeat('─', 62) . PHP_EOL . PHP_EOL;
    echo '  三种架构：' . PHP_EOL;
    foreach (Runtime::catalog() as $id => $meta) {
        printf("    %-8s %-16s %s%s\n", $id, $meta['label'], $meta['summary'],
            $meta['available'] ? '' : '（当前环境不可用）');
    }
    echo PHP_EOL;
}